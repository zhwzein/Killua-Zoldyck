# Pilihan login: true = Pairing Code, false = QR Code
PAIRING_CODE=false

# Nomor HP untuk Pairing Code (wajib jika PAIRING_CODE=true, contoh: 628xxxxxxxx)
PHONE_NUMBER=

# APIs
API_ZENZ=https://api.andaraz.com
API_KEY=YOURAPIKEY

# Options
AUTO_READ=true
SELF_MODE=false
LIMIT_COUNT=20
LIMIT_GAME=20

# Exif Sticker
EXIF_PACKNAME=Killua Zoldyck
EXIF_AUTHOR=https://api.andaraz.com

# Owner (dipisahkan dengan koma jika lebih dari satu)
OWNER=62812XXX

# Timezone & Footer
TIMEZONE=Asia/Jakarta
FOOTER=Powered by https://api.andaraz.com
